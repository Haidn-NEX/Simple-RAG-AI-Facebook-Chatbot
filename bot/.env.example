# ============================================================
# Danh sách biến môi trường cho Your Shop Bot
# Copy file này thành .env rồi điền giá trị thật vào
# TUYỆT ĐỐI KHÔNG commit file .env lên git
# ============================================================

# --- Facebook App ---
APP_ID=
APP_SECRET=
VERIFY_TOKEN=          # Tự đặt, ví dụ: my_pet_bot_2026

# --- Facebook Pages (Hỗ trợ 1 hoặc nhiều Page) ---
# Page 1 (Mặc định)
PAGE_ID=
PAGE_ACCESS_TOKEN=

# Page 2 (Tùy chọn — bot sẽ tự động nhận diện và trả lời đúng từng Page)
PAGE_ID2=
PAGE_ACCESS_TOKEN2=

# --- Graph API ---
GRAPH_API_VERSION=v26.0

# --- Google Gemini ---
GEMINI_API_KEY=        # Lấy tại aistudio.google.com

# --- Kho tri thức (RAG) từ Google Sheet ---
# ID nằm trong link: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# Sheet phải chia sẻ "Bất kỳ ai có đường liên kết: Người xem" và có 3 tab: prompt, data, knowledge
# Để trống SHEET_ID = dùng products.json như cũ
SHEET_ID=
SHOP_NAME=             # Tên shop trong lời chào đầu tiên; để trống thì bot gọi là "shop"
# Mức suy nghĩ của Gemini: minimal | low | medium | high | off (cần SDK hỗ trợ thinking_level)
GEMINI_THINKING=low
# Giây chờ model chính trước khi gọi model dự phòng song song
GEMINI_HEDGE_SECONDS=12
KB_REFRESH_SECONDS=300 # Bao lâu bot tự kéo dữ liệu mới từ Sheet một lần (giây)
KB_FULL_CONTEXT_CHARS=30000 # Dữ liệu ngắn hơn ngưỡng này (ký tự) thì đưa trọn vào prompt; dài hơn thì bot truy xuất theo từng câu hỏi
EMBED_MODEL=           # Tùy chọn: model embedding của Gemini để tìm theo ngữ nghĩa; để trống = tìm theo từ khóa
ADMIN_TOKEN=           # Tự đặt chuỗi dài ngẫu nhiên; dùng cho POST /admin/reload

# --- Server ---
PORT=8000
